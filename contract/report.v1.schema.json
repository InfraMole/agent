{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "agentVersion": {
      "type": "string",
      "maxLength": 32
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "host": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "fqdn": {
          "type": "string",
          "maxLength": 253
        },
        "os": {
          "type": "string",
          "enum": [
            "windows",
            "linux"
          ]
        },
        "osName": {
          "type": "string",
          "maxLength": 128
        },
        "osVersion": {
          "type": "string",
          "maxLength": 128
        },
        "kernelVersion": {
          "type": "string",
          "maxLength": 128
        },
        "arch": {
          "type": "string",
          "maxLength": 32
        },
        "bootTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "hostname",
        "os",
        "osName",
        "osVersion",
        "arch"
      ],
      "additionalProperties": false
    },
    "interfaces": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "mac": {
            "type": "string",
            "maxLength": 32
          },
          "addresses": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "name",
          "addresses"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "maxLength": 32
          },
          "startType": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "name",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "listeners": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proto": {
            "type": "string",
            "enum": [
              "tcp",
              "tcp6"
            ]
          },
          "address": {
            "type": "string",
            "maxLength": 64
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "process": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "pid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "proto",
          "address",
          "port"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proto": {
            "type": "string",
            "enum": [
              "tcp",
              "tcp6"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "localPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "remoteAddress": {
            "type": "string",
            "maxLength": 64
          },
          "remotePort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "process": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "pid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "proto",
          "direction",
          "localPort",
          "remoteAddress",
          "remotePort",
          "count",
          "firstSeen",
          "lastSeen"
        ],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "proxmox"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "items": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "enum": [
                  "node",
                  "qemu",
                  "lxc"
                ]
              },
              "node": {
                "type": "string",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "maxLength": 253
              },
              "vmid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "maxLength": 32
              },
              "maxmem": {
                "type": "number",
                "minimum": 0
              },
              "template": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source",
        "collectedAt",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "agentVersion",
    "collectedAt",
    "windowStart",
    "host",
    "interfaces",
    "services",
    "listeners",
    "connections"
  ],
  "additionalProperties": false
}
